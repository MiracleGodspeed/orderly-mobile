{
  "expo": {
    "name": "Orderly",
    "slug": "orderly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orderly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a3d8f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orderlystores.vendor",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "GIDClientID": "912473645778-idbsu2n6j9jtjk6em1g1eo817ia74h3f.apps.googleusercontent.com",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.912473645778-idbsu2n6j9jtjk6em1g1eo817ia74h3f"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.912473645778-idbsu2n6j9jtjk6em1g1eo817ia74h3f"
            ]
          }
        ],
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can upload banner images for your store.",
        "NSCameraUsageDescription": "We need camera access so you can take photos for your store.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "usesAppleSignIn": true,
      "appleTeamId": "X456K7C6SX"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.orderlystores.vendor",
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "notification": {
      "color": "#265CC7",
      "androidMode": "default",
      "androidCollapsedTitle": "Orderly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photos so you can upload banner images for your store.",
          "cameraPermission": "We need camera access so you can take photos for your store."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#265CC7",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "1cc515f9-d5b1-4404-81dd-94b3e7b4732e"
      }
    }
  }
}
